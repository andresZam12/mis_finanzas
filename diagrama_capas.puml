@startuml diagrama_capas

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam package {
    BackgroundColor #F8F9FA
    BorderColor #2C3E50
    FontSize 13
    FontStyle bold
}

skinparam class {
    BackgroundColor White
    BorderColor #2C3E50
    FontColor #000000
    FontSize 10
    FontStyle bold
}

skinparam interface {
    BackgroundColor #EBF5FB
    BorderColor #1A5276
    FontColor #000000
    FontSize 10
    FontStyle bold
}

skinparam ArrowColor #5D6D7E
skinparam ArrowFontSize 9

title <b>Diagrama por Capas — Arquitectura N-Capas</b>\nSistema de Finanzas Personales — POO UCC\n

' =====================================================
'  CAPA 0 — SEGURIDAD Y CONFIGURACIÓN (transversal)
' =====================================================
package "Capa Seguridad y Configuración  ·  Spring Security / Config" #F5EEF8 {

    class JwtUtil <<@Component>> {
        + generateToken(username: String)        : String
        + generateRefreshToken(username: String) : String
        + extractUsername(token: String)         : String
        + isRefreshToken(token: String)          : boolean
        + validateToken(token: String)           : boolean
    }

    class JwtFilter <<@Component\nextends OncePerRequestFilter>> {
        + doFilterInternal(request, response, chain) : void
    }

    class UserDetailsServiceImpl <<@Service\nimplements UserDetailsService>> {
        + loadUserByUsername(username: String) : UserDetails
    }

    class SecurityConfig <<@Configuration\n@EnableWebSecurity>> {
        + filterChain(http: HttpSecurity)    : SecurityFilterChain
        + passwordEncoder()                  : PasswordEncoder
    }

    class CorsConfig <<@Configuration>> {
        + corsConfigurationSource()          : CorsConfigurationSource
    }

    class MenuSeeder <<@Component\nimplements CommandLineRunner>> {
        + run(args: String[])                : void
    }
}

' =====================================================
'  CAPA 1 — CONTROLADORES (REST API)
' =====================================================
package "Capa Controladores  ·  REST API  /  Spring MVC" #D6EAF8 {

    class AuthController <<@RestController\n/auth>> {
        + registro(req: RegistroRequest)          : ResponseEntity
        + login(req: AuthRequest)                 : ResponseEntity
        + refresh(body: Map<String,String>)       : ResponseEntity
    }

    class MovimientoController <<@RestController\n/movimientos>> {
        + registrarIngreso(req: MovimientoRequest): ResponseEntity
        + registrarGasto(req: MovimientoRequest)  : ResponseEntity
        + listarIngresos(id: Long)                : ResponseEntity<List<Ingreso>>
        + listarGastos(id: Long)                  : ResponseEntity<List<Gasto>>
        + obtenerIngreso(id: Long)                : ResponseEntity
        + obtenerGasto(id: Long)                  : ResponseEntity
        + editarIngreso(id: Long, req)            : ResponseEntity
        + editarGasto(id: Long, req)              : ResponseEntity
        + eliminarIngreso(id: Long)               : ResponseEntity
        + eliminarGasto(id: Long)                 : ResponseEntity
        + calcularBalance(id: Long)               : ResponseEntity<Double>
    }

    class CategoriaController <<@RestController\n/categorias>> {
        + listarTodas()                           : ResponseEntity<List<Categoria>>
        + listarPorTipo(tipo: String)             : ResponseEntity<List<Categoria>>
        + crear(nombre: String, tipo: String)     : ResponseEntity
        + actualizar(id: Long, nombre, tipo)      : ResponseEntity
        + obtenerPorId(id: Long)                  : ResponseEntity
        + eliminar(id: Long)                      : ResponseEntity
    }

    class DeudaController <<@RestController\n/deudas>> {
        + registrarDeuda(req: DeudaRequest)       : ResponseEntity
        + editarDeuda(id: Long, req: DeudaRequest): ResponseEntity
        + marcarPagada(id: Long)                  : ResponseEntity
        + abonar(id: Long, monto: double)         : ResponseEntity
        + eliminar(id: Long)                      : ResponseEntity
        + listarDeudas(usuarioId: Long)           : ResponseEntity<List<Deuda>>
        + listarPorEstado(usuarioId, estado)      : ResponseEntity
        + listarPorTipo(usuarioId, tipo)          : ResponseEntity
    }

    class MetaAhorroController <<@RestController\n/metas>> {
        + crearMeta(req: MetaAhorroRequest)       : ResponseEntity
        + obtenerMeta(usuarioId, mes, anio)       : ResponseEntity
        + verificarCumplimiento(usuarioId,mes,anio): ResponseEntity
        + listarTodas(usuarioId: Long)            : ResponseEntity<List<MetaAhorro>>
        + eliminar(id: Long)                      : ResponseEntity
    }

    class AhorroController <<@RestController\n/ahorros>> {
        + registrar(req: AhorroRequest)           : ResponseEntity
        + listar(usuarioId: Long)                 : ResponseEntity<List<Ahorro>>
        + total(usuarioId: Long)                  : ResponseEntity<Double>
        + eliminar(id: Long)                      : ResponseEntity
    }

    class ReporteController <<@RestController\n/reportes>> {
        + generarReporte(usuarioId, mes, anio)    : ResponseEntity
        + calcularBalanceTotal(usuarioId: Long)   : ResponseEntity<Double>
    }

    class MenuController <<@RestController\n/menus>> {
        + listar()                                : ResponseEntity<List<Menu>>
    }
}

' =====================================================
'  CAPA 1.5 — DTOs (Transferencia de Datos)
' =====================================================
package "DTOs  ·  Objetos de Transferencia de Datos" #FEF5E7 {

    class AuthRequest {
        - username : String
        - password : String
    }

    class RegistroRequest {
        - username : String
        - password : String
        - nombre   : String
    }

    class AuthResponse {
        - token        : String
        - refreshToken : String
        - usuarioId    : Long
        - username     : String
    }

    class MovimientoRequest {
        - monto            : double
        - descripcion      : String
        - categoriaId      : Long
        - usuarioId        : Long
        - fuente           : String
        - tipoPago         : String
        - esRecurrente     : boolean
        - porcentajeAhorro : double
    }

    class DeudaRequest {
        - persona     : String
        - monto       : double
        - descripcion : String
        - tipo        : String
        - tipoPago    : String
        - usuarioId   : Long
    }

    class MetaAhorroRequest {
        - montoMeta : double
        - mes       : int
        - anio      : int
        - usuarioId : Long
    }

    class AhorroRequest {
        - monto       : double
        - porcentaje  : double
        - descripcion : String
        - usuarioId   : Long
    }
}

' =====================================================
'  CAPA 2 — SERVICIOS (Lógica de Negocio)
' =====================================================
package "Capa Servicios  ·  Lógica de Negocio" #D5F5E3 {

    class AuthService <<@Service>> {
        + login(req: AuthRequest)          : AuthResponse
        + registrar(req: RegistroRequest)  : Usuario
        + buscarPorId(id: Long)            : Usuario
    }

    class MovimientoService <<@Service>> {
        + registrarIngreso(req)            : Ingreso
        + registrarGasto(req)              : Gasto
        + obtenerIngreso(id: Long)         : Ingreso
        + obtenerGasto(id: Long)           : Gasto
        + editarIngreso(id, req)           : Ingreso
        + editarGasto(id, req)             : Gasto
        + eliminarIngreso(id: Long)        : void
        + eliminarGasto(id: Long)          : void
        + listarIngresos(uid: Long)        : List<Ingreso>
        + listarGastos(uid: Long)          : List<Gasto>
        + calcularBalance(uid: Long)       : double
        - normalizarTipoPago(s: String)    : String
    }

    class CategoriaService <<@Service>> {
        + crear(nombre, tipo)              : Categoria
        + editar(id, nombre, tipo)         : Categoria
        + eliminar(id: Long)               : void
        + listarTodas()                    : List<Categoria>
        + listarPorTipo(tipo: String)      : List<Categoria>
        + obtenerPorId(id: Long)           : Categoria
    }

    class DeudaService <<@Service>> {
        + registrarDeuda(req)              : Deuda
        + editarDeuda(id, req)             : Deuda
        + marcarPagada(id: Long)           : Deuda
        + abonarDeuda(id, monto)           : Deuda
        + eliminarDeuda(id: Long)          : void
        + listarPorUsuario(uid: Long)      : List<Deuda>
        + listarPorEstado(uid, estado)     : List<Deuda>
        + listarPorTipo(uid, tipo)         : List<Deuda>
        - normalizarTipoPago(s: String)    : String
    }

    class MetaAhorroService <<@Service>> {
        + crear(req)                       : MetaAhorro
        + eliminar(id: Long)               : void
        + listarPorUsuario(uid: Long)      : List<MetaAhorro>
        + consultarMeta(uid, mes, anio)    : MetaAhorro
        + verificarCumplimiento(uid,mes,a) : boolean
    }

    class AhorroService <<@Service>> {
        + registrar(req)                   : Ahorro
        + listarPorUsuario(uid: Long)      : List<Ahorro>
        + totalAhorros(uid: Long)          : double
        + eliminar(id: Long)               : void
    }

    class ReporteService <<@Service>> {
        + generarReporte(uid, mes, anio)   : ReporteFinanciero
        + calcularBalanceTotal(uid: Long)  : double
    }

    class MenuService <<@Service>> {
        + listarMenusRaiz()                : List<Menu>
    }
}

' =====================================================
'  CAPA 3 — REPOSITORIOS (Acceso a Datos / JPA)
' =====================================================
package "Capa Repositorios  ·  JPA  /  Spring Data" #FEF9E7 {

    interface UsuarioRepository {
        + findByUsername(u: String)              : Optional<Usuario>
    }

    interface IngresoRepository {
        + findByUsuarioId(uid: Long)             : List<Ingreso>
        + findByUsuarioIdAndFechaBetween(uid, desde, hasta) : List<Ingreso>
    }

    interface GastoRepository {
        + findByUsuarioId(uid: Long)             : List<Gasto>
        + findByUsuarioIdAndFechaBetween(uid, desde, hasta) : List<Gasto>
    }

    interface CategoriaRepository {
        + findByTipo(tipo: String)               : List<Categoria>
        + findAll()                              : List<Categoria>
    }

    interface DeudaRepository {
        + findByUsuarioId(uid: Long)             : List<Deuda>
        + findByUsuarioIdAndEstado(uid, estado)  : List<Deuda>
        + findByUsuarioIdAndTipo(uid, tipo)      : List<Deuda>
    }

    interface MetaAhorroRepository {
        + findByUsuarioId(uid: Long)             : List<MetaAhorro>
        + findByUsuarioIdAndMesAndAnio(uid,mes,a): Optional<MetaAhorro>
    }

    interface AhorroRepository {
        + findByUsuarioId(uid: Long)             : List<Ahorro>
        + sumMontoByUsuarioIdAndFechaBetween(uid, desde, hasta) : Double
    }

    interface MenuRepository {
        + findByPadreIsNullOrderByOrdenAsc()     : List<Menu>
    }
}

' =====================================================
'  CAPA 4 — MODELO / DOMINIO (Entidades JPA)
' =====================================================
package "Capa Modelo  ·  Dominio  /  Entidades JPA" #FDEDEC {

    abstract class Movimiento   <<abstracta / @MappedSuperclass>>
    class         Ingreso       <<@Entity — tabla: ingreso>>
    class         Gasto         <<@Entity — tabla: gasto>>
    interface     Recurrente    <<interfaz>>
    class         Usuario       <<@Entity — tabla: usuario>>
    class         Categoria     <<@Entity — tabla: categoria>>
    class         Deuda         <<@Entity — tabla: deuda>>
    class         Ahorro        <<@Entity — tabla: ahorro>>
    class         MetaAhorro    <<@Entity — tabla: meta_ahorro>>
    class         ReporteFinanciero <<sin BD — generado en memoria>>
    class         Menu          <<@Entity — tabla: menu>>

    Movimiento  <|--  Ingreso     : herencia
    Movimiento  <|--  Gasto       : herencia
    Recurrente  <|..  Ingreso     : realización
    Recurrente  <|..  Gasto       : realización
    Menu "1" *-- "0..*" Menu      : composición recursiva
}

' =====================================================
'  DEPENDENCIAS ENTRE CAPAS
' =====================================================

' Seguridad → Repositorios / Utilidades
JwtFilter            ..> JwtUtil
JwtFilter            ..> UserDetailsServiceImpl
UserDetailsServiceImpl ..> UsuarioRepository
SecurityConfig       ..> JwtFilter
SecurityConfig       ..> CorsConfig
MenuSeeder           ..> MenuRepository

' Controladores → DTOs
AuthController       ..> AuthRequest
AuthController       ..> RegistroRequest
AuthController       ..> AuthResponse
MovimientoController ..> MovimientoRequest
DeudaController      ..> DeudaRequest
MetaAhorroController ..> MetaAhorroRequest
AhorroController     ..> AhorroRequest

' Controladores → Servicios
AuthController       ..> AuthService
MovimientoController ..> MovimientoService
CategoriaController  ..> CategoriaService
DeudaController      ..> DeudaService
MetaAhorroController ..> MetaAhorroService
AhorroController     ..> AhorroService
ReporteController    ..> ReporteService
MenuController       ..> MenuService

' Servicios → Repositorios
AuthService          ..> UsuarioRepository
MovimientoService    ..> IngresoRepository
MovimientoService    ..> GastoRepository
MovimientoService    ..> CategoriaRepository
MovimientoService    ..> UsuarioRepository
MovimientoService    ..> AhorroRepository
CategoriaService     ..> CategoriaRepository
DeudaService         ..> DeudaRepository
DeudaService         ..> GastoRepository
DeudaService         ..> CategoriaRepository
DeudaService         ..> UsuarioRepository
MetaAhorroService    ..> MetaAhorroRepository
MetaAhorroService    ..> AhorroRepository
AhorroService        ..> AhorroRepository
ReporteService       ..> IngresoRepository
ReporteService       ..> GastoRepository
MenuService          ..> MenuRepository

' Repositorios → Modelos
UsuarioRepository    ..> Usuario
IngresoRepository    ..> Ingreso
GastoRepository      ..> Gasto
CategoriaRepository  ..> Categoria
DeudaRepository      ..> Deuda
MetaAhorroRepository ..> MetaAhorro
AhorroRepository     ..> Ahorro
MenuRepository       ..> Menu

@enduml
