@startuml diagrama_contexto
!theme plain

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam rectangle {
    BackgroundColor #D6EAF8
    BorderColor #1A5276
    FontSize 12
}

skinparam actor {
    BackgroundColor #FDFEFE
    BorderColor #2C3E50
    FontSize 12
}

skinparam database {
    BackgroundColor #FEF9E7
    BorderColor #B7950B
    FontSize 11
}

skinparam component {
    BackgroundColor #D5F5E3
    BorderColor #1E8449
    FontSize 11
}

skinparam arrow {
    Color #2C3E50
    FontSize 10
}

skinparam note {
    BackgroundColor #FEFBD8
    BorderColor #D4AC0D
    FontSize 10
}

title <b>Diagrama de Contexto</b>\nSistema de Finanzas Personales — POO UCC\n

' ======================================================
'  ACTORES EXTERNOS
' ======================================================
actor "Usuario\n(Andrés)" as usuario #EBF5FB

' ======================================================
'  FRONTERA DEL SISTEMA
' ======================================================
rectangle "Sistema de Finanzas Personales" as sistema {

    component "Frontend\nAngular 21\n(puerto 4200)" as frontend #D5F5E3
    component "Backend\nSpring Boot 3.4\n(puerto 8081)" as backend #FADBD8
    database  "Base de Datos\nPostgreSQL 17\n(puerto 5432)" as db #FEF9E7
}

' ======================================================
'  SISTEMAS EXTERNOS
' ======================================================
component "Navegador Web\n(Chrome / Edge)" as navegador #FDF2E9

' ======================================================
'  RELACIONES
' ======================================================

usuario    -->  navegador   : accede a la app\npor navegador

navegador  -->  frontend    : carga la SPA\n(HTML / CSS / JS)

frontend   -->  backend     : peticiones HTTP/REST\n(JSON · JWT en cabecera)

backend    -->  db          : consultas SQL\n(JDBC / JPA · Hibernate)

backend    -->  frontend    : respuestas JSON\n(entidades / reportes)

' ======================================================
'  NOTAS
' ======================================================
note right of frontend
  Single Page Application (SPA).
  Componentes standalone de Angular.
  Rutas protegidas con AuthGuard.
  JWT enviado en cada petición
  vía HttpInterceptor.
end note

note right of backend
  API RESTful stateless.
  Autenticación con JWT (JwtFilter).
  Arquitectura por capas:
  Controller → Service → Repository → Model.
  Seedea el menú dinámico al arrancar.
end note

note right of db
  7 tablas persistidas:
  usuario, ingreso, gasto,
  categoria, deuda, ahorro,
  meta_ahorro, menu.
  ReporteFinanciero NO se persiste
  (se genera en memoria).
end note

note bottom of usuario
  Único actor externo del sistema.
  Se registra, inicia sesión y gestiona
  sus finanzas personales desde el navegador.
end note

@enduml
