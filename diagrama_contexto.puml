@startuml diagrama_contexto

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    BorderThickness 1.5
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #000000
    FontColor #000000
    FontSize 12
    BorderThickness 1.5
}

skinparam ArrowColor #000000
skinparam ArrowFontSize 10
skinparam ArrowFontColor #000000

title <b>Diagrama de Contexto</b>\nSistema de Finanzas Personales — POO UCC\n

' ---- Entidades externas ----
rectangle "USUARIO" as usuario
rectangle "FRONTEND\nAngular 21" as frontend
rectangle "BACKEND\nSpring Boot 3.4" as backend
rectangle "BASE DE DATOS\nPostgreSQL (Neon)" as bd

' ---- Sistema central ----
usecase "SISTEMA DE\nFINANZAS\nPERSONALES" as sistema

' ---- Flujos de información ----
usuario   -->  sistema : Credenciales, datos de\nmovimientos, deudas y metas
sistema   -->  usuario : Dashboard, reportes\nfinancieros y confirmaciones

frontend  -->  sistema : Peticiones HTTP/REST\ncon token JWT
sistema   -->  frontend : Respuestas JSON\n(entidades y reportes)

sistema   -->  backend : Lógica de negocio:\nvalidar, calcular, persistir
backend   -->  sistema : Resultados procesados\ny datos estructurados

sistema   -->  bd : Guardar usuarios,\nmovimientos, deudas,\nahorros, categorías, menú
bd        -->  sistema : Consultar y recuperar\nregistros persistidos

@enduml
