@startuml diagrama_despliegue

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam node {
    BackgroundColor #EBF5FB
    BorderColor #1A5276
    FontSize 13
    FontStyle bold
}

skinparam artifact {
    BackgroundColor #FDFEFE
    BorderColor #2C3E50
    FontSize 11
}

skinparam database {
    BackgroundColor #FEF9E7
    BorderColor #B7950B
    FontSize 11
}

skinparam component {
    BackgroundColor #D5F5E3
    BorderColor #1E8449
    FontSize 11
}

skinparam ArrowColor #2C3E50
skinparam ArrowFontSize 10

skinparam note {
    BackgroundColor #FEFBD8
    BorderColor #D4AC0D
    FontSize 10
}

title <b>Diagrama de Despliegue</b>\nSistema de Finanzas Personales — POO UCC\n

' ======================================================
'  NODO 1 — DISPOSITIVO DEL USUARIO
' ======================================================
node "Dispositivo del Usuario\n«PC / Móvil»" as cliente {
    component "Navegador Web\n(Chrome / Edge / Mobile)" as navegador
}

' ======================================================
'  NODO 2 — VERCEL (CDN — Frontend)
' ======================================================
node "Vercel\n«CDN Cloud»\nmisfinanzas-jade.vercel.app" as vercel {
    artifact "Angular SPA\n(ng build --configuration=production)\ndist/finanzasFront/browser" as angularApp
    artifact "vercel.json\n(rewrites SPA routing)" as vercelJson
}

' ======================================================
'  NODO 3 — RENDER (Servidor — Backend)
' ======================================================
node "Render\n«Cloud Server — Free Tier»\nfinanzas-api-ns1u.onrender.com" as render {

    artifact "Dockerfile\n(maven:3.9.6-eclipse-temurin-21\n→ eclipse-temurin:21-jre-jammy)" as docker

    artifact "finanzas-0.0.1-SNAPSHOT.jar\n(Spring Boot 3.4.1 — Java 21)" as jar

    component "Spring Security\n(JwtFilter + BCrypt)" as security
    component "Capa REST\n(Controllers)" as controllers
    component "Lógica de Negocio\n(Services)" as services
    component "Acceso a Datos\n(Repositories + JPA)" as repositories
    component "MenuSeeder\n(CommandLineRunner)" as seeder

    docker       --> jar
    jar          --> security
    security     --> controllers
    controllers  --> services
    services     --> repositories
    seeder       --> repositories : puebla tabla menu\nal arrancar
}

' ======================================================
'  NODO 4 — NEON (Base de Datos en la nube)
' ======================================================
node "Neon\n«Serverless PostgreSQL Cloud»\nep-solitary-unit-apron6f7.neon.tech" as neon {

    database "neondb\n(sslmode=require)" as db {
        artifact "tabla: usuario"      as tUsuario
        artifact "tabla: ingreso"      as tIngreso
        artifact "tabla: gasto"        as tGasto
        artifact "tabla: categoria"    as tCategoria
        artifact "tabla: deuda"        as tDeuda
        artifact "tabla: ahorro"       as tAhorro
        artifact "tabla: meta_ahorro"  as tMeta
        artifact "tabla: menu"         as tMenu
    }
}

' ======================================================
'  COMUNICACIÓN ENTRE NODOS
' ======================================================
cliente  ..>  vercel  : HTTPS\n(solicita la SPA)

vercel   ..>  cliente : HTML / CSS / JS\n(Angular compilado)

cliente  ..>  render  : HTTPS / REST (JSON)\nAuthorization: Bearer JWT

render   ..>  cliente : Respuestas JSON\n(entidades / reportes)

render   ..>  neon    : JDBC / Hibernate\n(sslmode=require)\nddl-auto=update

' ======================================================
'  NOTAS
' ======================================================
note bottom of vercel
  Deploy automático desde GitHub (rama main).
  vercel.json redirige todas las rutas a index.html
  para soportar el enrutamiento de Angular.
  Variables de entorno: apiUrl apunta a Render.
end note

note bottom of render
  Contenedor Docker con Java 21.
  Stateless: no guarda sesión en servidor.
  JwtFilter valida el token en cada petición.
  Se duerme tras 15 min sin tráfico (free tier).
  Variables de entorno: DATABASE_URL, JWT_SECRET,
  DB_USERNAME, DB_PASSWORD, SPRING_PROFILES_ACTIVE=prod.
end note

note bottom of neon
  PostgreSQL serverless gratuito (512 MB).
  Sin vencimiento mientras el proyecto esté activo.
  Hibernate crea y actualiza las tablas al arrancar.
  ReporteFinanciero NO tiene tabla propia:
  se genera en memoria bajo demanda.
end note

@enduml
